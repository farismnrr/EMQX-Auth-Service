# =============================================================================
# EMQX Auth Service Configuration
# =============================================================================
LOG_LEVEL=
SECRET_KEY=
API_KEY=

# =============================================================================
# MySQL Configuration
# =============================================================================
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# =============================================================================
# MQTT Admin API Configuration
# =============================================================================
MQTT_ADMIN_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false
MQTT_ADMIN_USERNAME=
MQTT_ADMIN_PASSWORD=

# Shared Subscription (for multi-instance deployment)
# When enabled, only one instance receives each message (load balancing)
# Format: $share/{group_id}/{topic}
MQTT_USE_SHARED_SUB=true

# =============================================================================
# Password Encryption (AES-256-GCM)
# =============================================================================
# Generate with: openssl rand -hex 32
# Must be 64 hex characters (32 bytes)
MQTT_PASS_ENCRYPTION_KEY=