# =====================
# 🔑 Authentication & Security
# =====================
# Secret key for JWT signing (at least 32 characters recommended)
SECRET_KEY=your_super_secret_jwt_key_here
# API key for REST API authentication (header: x-api-key)
API_KEY=your_rest_api_key_here
# AES-256 encryption key for MQTT passwords (64 hex chars)
# Generate with: make key
MQTT_PASS_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# =====================
# 📁 Database (SQLite)
# =====================
# Path to the SQLite database file
DB_PATH=mqtt_auth.sqlite

# =====================
# 🪵 Logging & Performance
# =====================
# info, debug, error, warn
LOG_LEVEL=info
# REST API rate limit (requests per minute)
MQTT_AUTH_RATE_LIMIT=100

# =====================
# 🔌 MQTT Admin RPC (Optional)
# =====================
MQTT_ADMIN_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=password
# Comma-separated list of allowed requesters
MQTT_ADMIN_ALLOWED_REQUESTERS=iotnet-backend
# Shared subscription group for horizontal scaling (default: true)
MQTT_USE_SHARED_SUB=true
