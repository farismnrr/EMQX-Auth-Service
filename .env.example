# =====================
# 🔑 Authentication & Security
# =====================
SECRET_KEY=
API_KEY=
MQTT_PASS_ENCRYPTION_KEY=

# =====================
# 🗄️ Database Configuration
# =====================
# DB_TYPE options: sqlite, postgres, mysql
DB_TYPE=sqlite

# SQLite Configuration (used when DB_TYPE=sqlite)
DB_PATH=./data/mqtt_auth.sqlite

# PostgreSQL/MySQL Configuration (used when DB_TYPE=postgres or mysql)
# Option 1: Use full DATABASE_URL (overrides individual settings)
DATABASE_URL=

# Option 2: Use individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emqx_auth
DB_USER=postgres
DB_PASSWORD=

# Connection Pool Settings
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT=5
DB_IDLE_TIMEOUT=600

# =====================
# 🪵 Logging & Performance
# =====================
LOG_LEVEL=info
RUST_LOG=info
MQTT_AUTH_RATE_LIMIT=

# =====================
# 📊 OpenTelemetry Configuration
# =====================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=emqx-auth-service
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.version=1.0.0

# =====================
# 🔌 MQTT Admin RPC (Optional)
# =====================
MQTT_ADMIN_ENABLED=
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=
MQTT_USE_TLS=
MQTT_ADMIN_USERNAME=
MQTT_ADMIN_PASSWORD=
MQTT_ADMIN_ALLOWED_REQUESTERS=iotnet-backend
MQTT_USE_SHARED_SUB=
MQTT_ADMIN_CLIENT_ID=

# MQTT RPC Topic Prefixes (for compatibility with backend)
MQTT_TOPIC_AUTH_COMMAND_PREFIX=iotnet/auth/commands
MQTT_TOPIC_AUTH_REPLY_PREFIX=iotnet/auth/replies
